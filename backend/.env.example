# Copy to .env and fill in. NEVER commit .env
SECRET_KEY=smartcrmsecret123
JWT_SECRET_KEY=jwtsecret123456
JWT_EXPIRES_HOURS=12
# SQLite file by default. Leave blank to use backend/smartcrm.db
DATABASE_URL=
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Customers who spent at least this much are tagged "VIP"
VIP_THRESHOLD=500
# Optional: WooCommerce credentials can also be set from the Settings page
WC_STORE_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WC_WEBHOOK_SECRET=
